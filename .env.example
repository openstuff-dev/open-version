# Copy to .env and adjust. docker compose reads it automatically.

# Port on this machine.
PORT=8080

# How much the server logs: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# The database password. Change it before you put this on a server.
POSTGRES_PASSWORD=openversion

# Where people and open tabs reach OpenVersion, without a trailing slash. The setup snippets and
# the "What's new" links use it. Sign-in cookies are marked Secure when it starts with https://,
# and the dashboard refuses changes posted from any other origin.
OPENVERSION_PUBLIC_URL=http://localhost:8080

# The first admin, made on the first start. Leave the password empty to have one made and
# shown once in the log.
OPENVERSION_ADMIN_EMAIL=admin@example.com
OPENVERSION_ADMIN_PASSWORD=

# How many days people stay signed in.
OPENVERSION_SESSION_DAYS=30

# Encrypts integration keys (the OpenAnnounce publish key) with AES-256-GCM. Empty: a key is
# made on first start and kept in the database, so a database dump alone could reveal them.
# Set it on a server, e.g. to the output of: openssl rand -base64 32
# Changing it later means entering the integration keys again.
OPENVERSION_SECRET_KEY=

# Integrations (OpenAnnounce) fetch URLs people typed in, so internal addresses (localhost,
# 10.x, 192.168.x, the cloud metadata address) are refused by default. Set private to allow
# them, e.g. for an OpenAnnounce on the same network, and list the hosts that may use them.
OPENVERSION_FETCH=public
OPENVERSION_FETCH_ALLOW=

# A server-wide OpenAnnounce connection (the Integrations tab's server card). When the URL and
# public key are both set here, they win: the tab shows them read-only. The signing secret is
# only used to sign people's tokens for OpenAnnounce's messages.
OPENVERSION_OPENANNOUNCE_URL=
OPENVERSION_OPENANNOUNCE_PUBLIC_KEY=
OPENVERSION_OPENANNOUNCE_SIGNING_SECRET=

# Version checks allowed per public key and network address per minute; 0 turns the limit off.
# An office or a proxy shares one address: 1200 is about 6000 tabs checking every 5 minutes.
OPENVERSION_VERSION_RATE_LIMIT=1200

# Behind a reverse proxy (nginx, Caddy, Traefik): true, or the proxy's addresses. Without it,
# every tab seems to come from the proxy, and they all share one rate limit.
OPENVERSION_TRUST_PROXY=

# on: a pretend app at /demo that runs the client, to see the toast and reload happen.
OPENVERSION_DEMO=off
