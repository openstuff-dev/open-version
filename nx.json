{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": [
            "eslint",
            "@openstuff-dev/lint"
          ]
        }
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "stylelint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/stylelint.config.mjs",
        {
          "externalDependencies": [
            "stylelint",
            "@openstuff-dev/lint"
          ]
        }
      ]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ]
}
