{
  "name": "@openstuff-dev/version",
  "version": "0.0.0",
  "description": "Tell open browser tabs that a new version of your web app is live: a tiny client, the <ov-update> element and the openversion CLI for CI.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./update": {
      "types": "./dist/update/index.d.ts",
      "import": "./dist/update/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstuff-dev/open-version.git",
    "directory": "packages/version"
  },
  "keywords": [
    "version",
    "reload",
    "deploy",
    "stale",
    "chunkloaderror",
    "web-components",
    "openversion"
  ],
  "engines": {
    "node": ">=20"
  },
  "nx": {
    "name": "version",
    "tags": [
      "type:package"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "bin": {
    "openversion": "./dist/cli/index.js"
  },
  "sideEffects": [
    "./dist/update/*",
    "./dist/cli/*"
  ]
}
