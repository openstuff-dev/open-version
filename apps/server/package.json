{
  "name": "@open-version/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "@fastify/cookie": "^11.1.5",
    "@fastify/swagger": "^9.5.2",
    "pg": "^8.23.1",
    "zod": "^4.6.6",
    "@openstuff-dev/version": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "@types/pg": "^8.23.1",
    "@open-version/contracts": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "nx": {
    "name": "server",
    "tags": [
      "type:app"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "dev": {
        "continuous": true
      }
    }
  }
}
